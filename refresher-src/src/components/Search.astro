---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="search-overlay" data-search hidden>
  <div class="search-backdrop" data-search-close></div>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="Search modules">
    <div class="search-input-row">
      <span class="search-icon" aria-hidden="true">⌕</span>
      <input
        type="text"
        class="search-input"
        placeholder="Search all modules…"
        autocomplete="off"
        spellcheck="false"
        data-search-input
      />
      <kbd>esc</kbd>
    </div>
    <ul class="search-results" data-search-results></ul>
    <p class="search-empty" data-search-empty hidden>No matches.</p>
    <p class="search-hint">
      <kbd>↑</kbd><kbd>↓</kbd> move · <kbd>↵</kbd> open
    </p>
  </div>
</div>

<script is:inline define:vars={{ indexUrl: `${base}/search.json` }}>
  (() => {
    const overlay = document.querySelector('[data-search]');
    if (!overlay) return;
    const input = overlay.querySelector('[data-search-input]');
    const list = overlay.querySelector('[data-search-results]');
    const empty = overlay.querySelector('[data-search-empty]');

    let index = null;
    let loading = null;
    let active = 0;

    const load = () => {
      if (index) return Promise.resolve(index);
      if (!loading) {
        loading = fetch(indexUrl)
          .then((r) => r.json())
          .then((d) => (index = d))
          .catch(() => (index = []));
      }
      return loading;
    };

    function open() {
      overlay.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      load().then(() => input.focus());
      input.focus();
      input.select();
    }

    function close() {
      overlay.hidden = true;
      document.documentElement.style.overflow = '';
    }

    function escapeHtml(s) {
      return s.replace(
        /[&<>"]/g,
        (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]
      );
    }

    // Excerpt around the first matched term, with the term marked.
    function excerpt(text, terms) {
      const lower = text.toLowerCase();
      let at = -1;
      for (const t of terms) {
        const i = lower.indexOf(t);
        if (i !== -1 && (at === -1 || i < at)) at = i;
      }
      if (at === -1) at = 0;
      const start = Math.max(0, at - 60);
      let slice = text.slice(start, start + 190);
      if (start > 0) slice = '…' + slice;
      if (start + 190 < text.length) slice += '…';
      let html = escapeHtml(slice);
      for (const t of terms) {
        html = html.replace(
          new RegExp(`(${t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi'),
          '<mark>$1</mark>'
        );
      }
      return html;
    }

    function score(rec, terms) {
      let s = 0;
      const hay = (rec.m + ' ' + rec.h + ' ' + (rec.k || '')).toLowerCase();
      const body = rec.t.toLowerCase();
      for (const t of terms) {
        if (hay.includes(t)) s += 12;
        const i = body.indexOf(t);
        if (i !== -1) s += 4 + Math.max(0, 3 - Math.floor(i / 400));
        else if (!hay.includes(t)) return 0; // every term must appear
      }
      return s;
    }

    function render(results, terms) {
      active = 0;
      list.innerHTML = results
        .map(
          (r, i) => `
          <li>
            <a href="${r.u}" class="search-hit${i === 0 ? ' is-active' : ''}" data-hit>
              <span class="search-hit-crumb"><span class="search-hit-n">${r.n}</span>${escapeHtml(r.m)} <span class="search-hit-sep">›</span> ${escapeHtml(r.h)}</span>
              <span class="search-hit-text">${excerpt(r.t, terms)}</span>
            </a>
          </li>`
        )
        .join('');
      empty.hidden = results.length > 0;
    }

    function run() {
      const q = input.value.trim().toLowerCase();
      if (!q || !index) {
        list.innerHTML = '';
        empty.hidden = true;
        return;
      }
      const terms = q.split(/\s+/).filter(Boolean);
      const results = index
        .map((r) => ({ r, s: score(r, terms) }))
        .filter((x) => x.s > 0)
        .sort((a, b) => b.s - a.s || a.r.n - b.r.n)
        .slice(0, 12)
        .map((x) => x.r);
      render(results, terms);
    }

    function move(delta) {
      const hits = list.querySelectorAll('[data-hit]');
      if (!hits.length) return;
      hits[active]?.classList.remove('is-active');
      active = (active + delta + hits.length) % hits.length;
      hits[active].classList.add('is-active');
      hits[active].scrollIntoView({ block: 'nearest' });
    }

    input.addEventListener('input', () => {
      load().then(run);
      run();
    });

    overlay.querySelector('[data-search-close]').addEventListener('click', close);

    overlay.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        move(1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        move(-1);
      } else if (e.key === 'Enter') {
        const hit = list.querySelectorAll('[data-hit]')[active];
        if (hit) {
          e.preventDefault();
          window.location.href = hit.getAttribute('href');
        }
      }
    });

    document.querySelectorAll('[data-search-open]').forEach((b) =>
      b.addEventListener('click', open)
    );

    window.__openSearch = open;
  })();
</script>

{/* Result rows are built with innerHTML, so their styles cannot be scoped. */}
<style is:global>
  .search-hit {
    display: block;
    padding: 0.5rem 0.65rem;
    border-radius: 5px;
    text-decoration: none;
    border-inline-start: 2px solid transparent;
  }

  .search-hit.is-active {
    background: var(--bg-sunken);
    border-inline-start-color: var(--accent);
  }

  .search-hit-crumb {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-strong);
    margin-block-end: 0.2rem;
  }

  .search-hit-n {
    display: inline-block;
    min-width: 1.35rem;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .search-hit-sep {
    color: var(--ink-faint);
    font-weight: 400;
    padding-inline: 0.15rem;
  }

  .search-hit-text {
    display: block;
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .search-hit-text mark {
    background: color-mix(in oklab, var(--accent) 30%, transparent);
    color: var(--ink-strong);
    border-radius: 2px;
    padding: 0 0.1em;
  }
</style>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    justify-content: center;
    padding: 8vh 1rem 1rem;
  }

  .search-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, var(--bg-sunken) 78%, transparent);
    backdrop-filter: blur(2px);
  }

  .search-panel {
    position: relative;
    width: min(42rem, 100%);
    max-height: 74vh;
    display: flex;
    flex-direction: column;
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-radius: 8px;
    box-shadow: 0 16px 48px rgb(0 0 0 / 0.35);
    overflow: hidden;
    font-family: var(--font-sans);
  }

  .search-input-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 0.9rem;
    border-block-end: 1px solid var(--rule);
  }

  .search-icon {
    color: var(--ink-faint);
    font-size: 1.1rem;
    line-height: 1;
  }

  .search-input {
    flex: 1;
    background: none;
    border: 0;
    outline: none;
    color: var(--ink-strong);
    font-family: inherit;
    font-size: 0.9375rem;
  }

  .search-input::placeholder {
    color: var(--ink-faint);
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 0.35rem;
    overflow-y: auto;
    flex: 1;
  }

  .search-empty,
  .search-hint {
    margin: 0;
    padding: 0.6rem 0.9rem;
    font-size: 0.6875rem;
    color: var(--ink-faint);
  }

  .search-hint {
    border-block-start: 1px solid var(--rule-soft);
    display: flex;
    gap: 0.3rem;
    align-items: center;
  }
</style>
