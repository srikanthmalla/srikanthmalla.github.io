---
import { render } from 'astro:content';
import ModuleLayout from '../layouts/ModuleLayout.astro';
import { allModules, neighbours } from '../lib/parts';

export async function getStaticPaths() {
  const mods = await allModules();
  return mods.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, ...neighbours(mods, entry.id) },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<ModuleLayout entry={entry} headings={headings} prev={prev} next={next}>
  <Content />
</ModuleLayout>
