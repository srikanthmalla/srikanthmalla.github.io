---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Search from '../components/Search.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description?: string;
  current?: string;
  headings?: MarkdownHeading[];
  /** breadcrumb text shown in the top bar */
  crumb?: string;
}

const { title, description = '', current, headings, crumb } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="data:," />

    {/* Applied before first paint so the dark default never flashes. */}
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('refresher:theme');
          if (t === 'light') document.documentElement.classList.add('light');
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <a href="#content" class="skip">Skip to content</a>

    <div class="shell">
      <aside class="rail" data-rail>
        <Sidebar current={current} headings={headings} />
      </aside>

      <div class="col">
        <header class="topbar">
          <button class="icon-btn only-narrow" data-rail-toggle aria-label="Toggle contents">
            <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
              <path d="M1.5 3.5h12M1.5 7.5h12M1.5 11.5h12" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path>
            </svg>
          </button>

          <p class="crumb">{crumb ?? 'Contents'}</p>

          <div class="topbar-actions">
            <button class="search-btn" data-search-open aria-label="Search">
              <span aria-hidden="true">⌕</span>
              <span class="search-btn-label">Search</span>
              <kbd>/</kbd>
            </button>
            <button class="icon-btn" data-theme-toggle aria-label="Toggle theme">
              <svg class="i-sun" width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                <circle cx="7.5" cy="7.5" r="3" stroke="currentColor" stroke-width="1.2"></circle>
                <path d="M7.5 .8v1.7M7.5 12.5v1.7M14.2 7.5h-1.7M2.5 7.5H.8M12.24 2.76l-1.2 1.2M3.96 11.04l-1.2 1.2M12.24 12.24l-1.2-1.2M3.96 3.96l-1.2-1.2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path>
              </svg>
              <svg class="i-moon" width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                <path d="M13 9.3A5.8 5.8 0 0 1 5.7 2 5.9 5.9 0 1 0 13 9.3Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"></path>
              </svg>
            </button>
            <a class="site-link" href="/learning.html">srikanthmalla.com</a>
          </div>
        </header>

        <main id="content"><slot /></main>
      </div>
    </div>

    <Search />

    <script is:inline define:vars={{ base }}>
      (() => {
        const root = document.documentElement;

        /* ---- theme ---------------------------------------------------- */
        document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
          const light = root.classList.toggle('light');
          try {
            localStorage.setItem('refresher:theme', light ? 'light' : 'dark');
          } catch (e) {}
        });

        /* ---- progress (localStorage) ---------------------------------- */
        const KEY = 'refresher:progress';
        const readSet = () => {
          try {
            return new Set(JSON.parse(localStorage.getItem(KEY) || '[]'));
          } catch (e) {
            return new Set();
          }
        };
        const writeSet = (s) => {
          try {
            localStorage.setItem(KEY, JSON.stringify([...s]));
          } catch (e) {}
        };

        function paintProgress() {
          const done = readSet();
          const ticks = document.querySelectorAll('[data-tick]');
          // A module can own more than one tick (rail + contents card), so
          // count distinct module ids rather than elements.
          const ids = new Set();
          ticks.forEach((t) => {
            const id = t.getAttribute('data-tick');
            ids.add(id);
            if (done.has(id)) t.setAttribute('data-read', '');
            else t.removeAttribute('data-read');
          });
          const n = [...ids].filter((id) => done.has(id)).length;
          const total = ids.size || 1;
          const fill = document.querySelector('[data-progress-fill]');
          if (fill) fill.style.width = `${(n / total) * 100}%`;
          const count = document.querySelector('[data-progress-count]');
          if (count) count.textContent = String(n);
          document.querySelectorAll('[data-mark]').forEach((btn) => {
            const id = btn.getAttribute('data-mark');
            const on = done.has(id);
            btn.setAttribute('aria-pressed', String(on));
            btn.textContent = on ? '✓ Reviewed' : 'Mark as reviewed';
          });
        }

        document.querySelectorAll('[data-mark]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-mark');
            const s = readSet();
            s.has(id) ? s.delete(id) : s.add(id);
            writeSet(s);
            paintProgress();
          });
        });

        paintProgress();

        /* ---- scrollspy over h2s, mirrored into the rail --------------- */
        const article = document.querySelector('[data-article]');
        const heads = article ? [...article.querySelectorAll('h2[id]')] : [];
        const subLinks = new Map(
          [...document.querySelectorAll('[data-toc]')].map((a) => [
            a.getAttribute('data-toc'),
            a,
          ])
        );

        if (heads.length && subLinks.size) {
          let currentId = null;
          const spy = () => {
            let found = heads[0].id;
            for (const h of heads) {
              if (h.getBoundingClientRect().top <= 96) found = h.id;
              else break;
            }
            if (found === currentId) return;
            subLinks.get(currentId)?.classList.remove('is-current');
            currentId = found;
            const el = subLinks.get(currentId);
            if (el) {
              el.classList.add('is-current');
              el.scrollIntoView({ block: 'nearest' });
            }
          };
          spy();
          addEventListener('scroll', spy, { passive: true });
        }

        /* ---- keyboard ------------------------------------------------- */
        const stops = article
          ? [...article.querySelectorAll('h2[id], h3[id]')]
          : [];

        function jump(delta) {
          if (!stops.length) return;
          // The heading we are "in": the last one scrolled past the threshold.
          let cur = -1;
          for (let i = 0; i < stops.length; i++) {
            if (stops[i].getBoundingClientRect().top <= 100) cur = i;
            else break;
          }
          const target = cur + delta;
          if (target < 0) return scrollTo({ top: 0, behavior: 'smooth' });
          if (target >= stops.length) return;
          stops[target].scrollIntoView({ block: 'start' });
        }

        addEventListener('keydown', (e) => {
          const tag = (e.target.tagName || '').toLowerCase();
          if (tag === 'input' || tag === 'textarea' || e.target.isContentEditable) return;
          if (e.metaKey || e.ctrlKey || e.altKey) return;

          if (e.key === '/') {
            e.preventDefault();
            window.__openSearch?.();
          } else if (e.key === 'j') {
            e.preventDefault();
            jump(1);
          } else if (e.key === 'k') {
            e.preventDefault();
            jump(-1);
          } else if (e.key === '[' || e.key === ']') {
            const sel = e.key === '[' ? '[data-prev]' : '[data-next]';
            const a = document.querySelector(sel);
            if (a) {
              e.preventDefault();
              window.location.href = a.getAttribute('href');
            }
          }
        });

        /* ---- narrow-screen rail --------------------------------------- */
        const rail = document.querySelector('[data-rail]');
        document.querySelector('[data-rail-toggle]')?.addEventListener('click', () => {
          rail.classList.toggle('is-open');
        });
        rail?.addEventListener('click', (e) => {
          if (e.target.closest('a')) rail.classList.remove('is-open');
        });
      })();
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    inset-inline-start: -9999px;
    z-index: 100;
  }
  .skip:focus {
    inset-inline-start: 0.5rem;
    top: 0.5rem;
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    padding: 0.4rem 0.7rem;
    border-radius: 4px;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
  }

  .shell {
    display: grid;
    grid-template-columns: 1fr;
    min-height: 100vh;
  }

  .rail {
    display: none;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    border-inline-end: 1px solid var(--rule);
    background: var(--bg-sunken);
  }

  .col {
    min-width: 0;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 3.25rem;
    padding-inline: 1rem;
    background: color-mix(in oklab, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-block-end: 1px solid var(--rule);
    font-family: var(--font-sans);
  }

  .crumb {
    margin: 0;
    flex: 1;
    min-width: 0;
    font-size: 0.75rem;
    color: var(--ink-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .search-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    height: 1.85rem;
    padding-inline: 0.55rem;
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-radius: 5px;
    color: var(--ink-muted);
    font-family: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }

  .search-btn:hover {
    color: var(--ink-strong);
    border-color: var(--ink-faint);
  }

  .search-btn-label {
    display: none;
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    background: none;
    border: 1px solid transparent;
    border-radius: 5px;
    color: var(--ink-muted);
    cursor: pointer;
  }

  .icon-btn:hover {
    color: var(--ink-strong);
    background: var(--bg-raised);
    border-color: var(--rule);
  }

  .i-sun {
    display: none;
  }
  :global(html.light) .i-sun {
    display: block;
  }
  :global(html.light) .i-moon {
    display: none;
  }

  .site-link {
    display: none;
    font-size: 0.75rem;
    color: var(--ink-faint);
    text-decoration: none;
    padding-inline-start: 0.35rem;
  }

  .site-link:hover {
    color: var(--accent);
  }

  @media (min-width: 640px) {
    .search-btn-label {
      display: inline;
    }
    .site-link {
      display: inline;
    }
  }

  @media (min-width: 1024px) {
    .shell {
      grid-template-columns: 17.5rem minmax(0, 1fr);
    }
    .rail {
      display: block;
    }
    .only-narrow {
      display: none;
    }
    .topbar {
      padding-inline: 2rem;
    }
  }

  /* Narrow: rail slides over the content. */
  @media (max-width: 1023px) {
    .rail.is-open {
      display: block;
      position: fixed;
      inset-block: 0;
      inset-inline-start: 0;
      width: min(20rem, 84vw);
      z-index: 50;
      box-shadow: 0 0 40px rgb(0 0 0 / 0.4);
    }
  }
</style>
