---
/**
 * The module's mental model as one picture, at the top of the page.
 *
 * Deliberately not a <Figure>: figures are click-to-reveal evidence for a
 * specific claim, whereas this is the map at the trailhead — you want it before
 * you have decided to read anything, and again when you come back to skim. So
 * it is always open and needs no trigger.
 *
 * The claim names the picture; the picture is the thing you are meant to
 * remember. A card of bullet points would restate the prose — a diagram encodes
 * the relationships the prose spends three paragraphs establishing.
 */
interface Props {
  /** One sentence naming what the diagram shows. */
  claim: string;
  /** Optional closing strip — usually the trap. */
  closeLabel?: string;
  close?: string;
}

const { claim, closeLabel = 'Trap', close } = Astro.props;
---

<aside class="ovw" aria-label="Module mental model">
  <p class="ovw-kicker">The mental model</p>
  <p class="ovw-claim">{claim}</p>
  <div class="ovw-fig"><slot /></div>
  {
    close && (
      <p class="ovw-close">
        <span class="ovw-tag" data-kind={closeLabel.toLowerCase()}>
          {closeLabel}
        </span>
        {close}
      </p>
    )
  }
</aside>
