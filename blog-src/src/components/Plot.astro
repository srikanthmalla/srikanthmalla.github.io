---
/**
 * A small line plot for the curves that recur across the series: traffic
 * against capacity, throughput against concurrency, cost against batch size.
 *
 * Either axis can be log. Series are direct-labelled at their last point rather
 * than carrying a legend box, so identity never depends on colour alone.
 */
interface Series {
  points: [number, number][];
  label: string;
  tone?: 1 | 2 | 3;
  dashed?: boolean;
  /** Nudge the end label vertically, in px, when two series end close together. */
  dy?: number;
}
interface Mark {
  x: number;
  y: number;
  label: string;
  tone?: 1 | 2 | 3;
  flip?: boolean;
}
interface Props {
  series: Series[];
  marks?: Mark[];
  xLabel: string;
  yLabel: string;
  xLog?: boolean;
  yLog?: boolean;
  xTicks?: number[];
  yTicks?: number[];
  /** Format a tick value. */
  fmtX?: (v: number) => string;
  fmtY?: (v: number) => string;
  alt: string;
}

const {
  series,
  marks = [],
  xLabel,
  yLabel,
  xLog = false,
  yLog = false,
  xTicks,
  yTicks,
  alt,
} = Astro.props;

const all = series.flatMap((s) => s.points).concat(marks.map((m) => [m.x, m.y] as [number, number]));
const xsAll = all.map((p) => p[0]);
const ysAll = all.map((p) => p[1]);

const xlo = Math.min(...xsAll);
const xhi = Math.max(...xsAll);
const ylo = yLog ? Math.min(...ysAll) : Math.min(0, ...ysAll);
const yhi = Math.max(...ysAll) * 1.12;

const W = 620,
  H = 320,
  L = 62,
  R = 96,
  T = 20,
  B = 46;
const pw = W - L - R,
  ph = H - T - B;

const lg = Math.log10;
const sx = (x: number) =>
  xLog
    ? L + ((lg(x) - lg(xlo)) / (lg(xhi) - lg(xlo))) * pw
    : L + ((x - xlo) / (xhi - xlo)) * pw;
const sy = (y: number) =>
  yLog
    ? T + ph - ((lg(y) - lg(ylo)) / (lg(yhi) - lg(ylo))) * ph
    : T + ph - ((y - ylo) / (yhi - ylo)) * ph;

const decades = (a: number, b: number) => {
  const out: number[] = [];
  for (let e = Math.ceil(lg(a)); e <= Math.floor(lg(b)); e++) out.push(10 ** e);
  return out;
};
const linTicks = (a: number, b: number, n = 5) => {
  const out: number[] = [];
  for (let i = 0; i <= n; i++) out.push(a + ((b - a) * i) / n);
  return out;
};

const xt = xTicks ?? (xLog ? decades(xlo, xhi) : linTicks(xlo, xhi));
const yt = yTicks ?? (yLog ? decades(ylo, yhi) : linTicks(ylo, yhi));

const num = (v: number) => {
  const a = Math.abs(v);
  if (a >= 1e6) return `${+(v / 1e6).toFixed(1)}M`;
  if (a >= 1000) return `${+(v / 1000).toFixed(a >= 10000 ? 0 : 1)}k`;
  if (a >= 10) return `${Math.round(v)}`;
  if (a >= 1) return `${+v.toFixed(1)}`;
  return `${+v.toFixed(2)}`;
};

const toneVar = (t?: number) => `var(--fig-${t ?? 1})`;
const path = (pts: [number, number][]) =>
  pts.map((p, i) => `${i ? 'L' : 'M'}${sx(p[0]).toFixed(1)} ${sy(p[1]).toFixed(1)}`).join(' ');
---

<svg
  class="chart"
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-label={alt}
  preserveAspectRatio="xMidYMid meet"
>
  {xt.map((t) => <line class="c-grid" x1={sx(t)} x2={sx(t)} y1={T} y2={T + ph} />)}
  {yt.map((t) => <line class="c-grid" x1={L} x2={L + pw} y1={sy(t)} y2={sy(t)} />)}

  <line class="c-axis" x1={L} x2={L + pw} y1={T + ph} y2={T + ph}></line>
  <line class="c-axis" x1={L} x2={L} y1={T} y2={T + ph}></line>

  {
    xt.map((t) => (
      <text class="c-tick" x={sx(t)} y={T + ph + 15} text-anchor="middle">
        {num(t)}
      </text>
    ))
  }
  {
    yt.map((t) => (
      <text class="c-tick" x={L - 7} y={sy(t) + 3.5} text-anchor="end">
        {num(t)}
      </text>
    ))
  }

  <text class="c-axlabel" x={L + pw / 2} y={H - 8} text-anchor="middle">{xLabel}</text>
  <text
    class="c-axlabel"
    transform={`rotate(-90 13 ${T + ph / 2})`}
    x="13"
    y={T + ph / 2}
    text-anchor="middle">{yLabel}</text
  >

  {
    series.map((s) => (
      <path
        class={`c-line${s.dashed ? ' is-dashed' : ''}`}
        d={path(s.points)}
        stroke={toneVar(s.tone)}
      />
    ))
  }

  {
    series.map((s) => {
      const last = s.points[s.points.length - 1];
      return (
        <text
          class="c-serieslbl"
          x={sx(last[0]) + 8}
          y={sy(last[1]) + 4 + (s.dy ?? 0)}
          text-anchor="start"
        >
          {s.label}
        </text>
      );
    })
  }

  {
    marks.map((m) => (
      <>
        <circle class="c-dot-ring" cx={sx(m.x)} cy={sy(m.y)} r="6.5" />
        <circle cx={sx(m.x)} cy={sy(m.y)} r="4.5" fill={toneVar(m.tone)} />
        <text
          class="c-ptlbl"
          x={sx(m.x) + (m.flip ? -10 : 10)}
          y={sy(m.y) - 9}
          text-anchor={m.flip ? 'end' : 'start'}
        >
          {m.label}
        </text>
      </>
    ))
  }
</svg>
